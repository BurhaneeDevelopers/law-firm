# Gemini API for LexAI. Without it the assistant returns demo answers.
GEMINI_API_KEY=

# Payment alert emails (Resend). Without RESEND_API_KEY nothing is sent and
# Settings shows "Email service not set up".
RESEND_API_KEY=
# Verified sender address, e.g. LexFirm <alerts@yourfirm.in>
EMAIL_FROM=
# Only this address can receive alert mail. Set it in production.
ADMIN_EMAIL=
